                { -1.7539, 0.3810, -0.4123, -0.3496, 0.5153, -0.9289, 0.0956, 0.9550, -0.8262, 0.4469, -1.2809, -0.5548, 0.5921, 0.1609, 0.4859, -8.3303 },
